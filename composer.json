{
    "name": "fewchurs/laravel",
    "description": "Drop a Fewchurs feature-request board into any Laravel app.",
    "keywords": ["laravel", "feedback", "feature-requests", "roadmap", "fewchurs"],
    "homepage": "https://fewchurs.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Fewchurs",
            "homepage": "https://fewchurs.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "livewire/livewire": "^3.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Fewchurs\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fewchurs\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "analyse": "phpstan analyse",
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fewchurs\\Laravel\\FewchursServiceProvider"
            ],
            "aliases": {
                "Fewchurs": "Fewchurs\\Laravel\\Facades\\Fewchurs"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
