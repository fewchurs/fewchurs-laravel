{
    "name": "fewchurs/laravel",
    "description": "Drop a Fewchurs feature-request board into any Laravel app.",
    "keywords": ["laravel", "feedback", "feature-requests", "roadmap", "fewchurs"],
    "homepage": "https://www.fewchurs.com",
    "license": "proprietary",
    "authors": [
        {
            "name": "Fewchurs",
            "homepage": "https://www.fewchurs.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.5|^8.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.18",
        "livewire/livewire": "^3.0|^4.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.34|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "phpstan/phpstan": "^1.12|^2.0"
    },
    "autoload": {
        "psr-4": {
            "Fewchurs\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fewchurs\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fewchurs\\Laravel\\FewchursServiceProvider"
            ],
            "aliases": {
                "Fewchurs": "Fewchurs\\Laravel\\Facades\\Fewchurs"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
